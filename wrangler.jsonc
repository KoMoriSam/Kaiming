{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaiming",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  }
}
